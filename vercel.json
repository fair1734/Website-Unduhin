
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "builds": [
    {
      "src": "src/app.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "public/**",
          "bin/**"
        ]
      }
    },
    {
      "src": "api/python-check.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/python-check",
      "dest": "/api/python-check.py"
    },
    {
      "src": "/(.*)",
      "dest": "src/app.js"
    }
  ]
}
