{
  "name": "unduhin",
  "version": "1.0.0",
  "description": "Pengunduh video dan foto tanpa watermark dari tautan media sosial.",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "cli": "node bin/unduhin-cli.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "lint": "node scripts/check.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "dependencies": {
    "archiver": "8.0.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0"
  }
}
