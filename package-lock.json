const http = require('http');
const fs = require('fs');
const path = require('path');
const dir = '/public/Project/keiba-japan';
const types = { '.html': 'text/html', '.css': 'text/css', '.js': 'application/javascript' };
const server = http.createServer((req, res) => {
  let urlPath = decodeURIComponent(req.url.split('?')[0]);
  if (urlPath === '/') urlPath = '/buka-ini.html';
  const fp = path.join(dir, urlPath);
  fs.readFile(fp, (err, data) => {
    if (err) { res.writeHead(404); res.end('not found'); return; }
    res.writeHead(200, { 'Content-Type': types[path.extname(fp)] || 'text/plain' });
    res.end(data);
  });
});
server.listen(8099, '127.0.0.1', () => console.log('SERVING 8099'));
